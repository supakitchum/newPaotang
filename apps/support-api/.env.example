APP_NAME="NewPaotang Support API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost/support-api

DB_CONNECTION=pgsql
DB_HOST=support-postgres
DB_PORT=5432
DB_DATABASE=newpaotang_support
DB_TEST_DATABASE=newpaotang_support_test
DB_USERNAME=newpaotang_support
DB_PASSWORD=newpaotang_support

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=support-valkey
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=newpaotang-support-local
REVERB_APP_KEY=newpaotang-support
REVERB_APP_SECRET=newpaotang-support-secret
REVERB_HOST=support-reverb
REVERB_PORT=8081
REVERB_SCHEME=http

SUPPORT_JWT_ISSUER=newpaotang-platform-api
SUPPORT_JWT_AUDIENCE=newpaotang-support
SUPPORT_JWT_PUBLIC_KEY_PATH=/run/secrets/support-jwt-public.pem
SUPPORT_ATTACHMENT_DISK=local
SUPPORT_AGENT_DEFAULT_CAPACITY=3
PLATFORM_NOTIFICATION_INGRESS_URL=http://platform-api:8000/api/v1/internal/customer-support/notifications
PLATFORM_SUPPORT_INGRESS_SECRET=
SUPPORT_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3100
SUPPORT_CORS_ALLOWED_ORIGIN_PATTERNS=
SUPPORT_REVERB_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3100,*.localhost,newpaotang.test,*.newpaotang.test
PLATFORM_NOTIFICATION_CIRCUIT_BREAKER_SECONDS=60
